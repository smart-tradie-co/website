---
import Layout from "@/layouts/Layout.astro";
import HeroSection from "@/components/home/HeroSection.astro";
import SectionHeader from "@/components/elements/SectionHeader.astro";
import Button from "@/components/ui/Button.astro";
import {
	ArrowRight,
	BookOpen,
	FileText,
	Layers,
	Palette,
	Sparkles,
} from "@lucide/astro";

const starterScope = [
	{
		icon: Palette,
		title: "Work smarter",
		desc: "Build a business that is easier to manage, with systems that support you instead of slowing you down.",
	},
	{
		icon: FileText,
		title: "Clearer systems",
		desc: "Build practical systems that make the day-to-day work easier to run and easier to grow.",
	},
	{
		icon: BookOpen,
		title: "Useful ideas",
		desc: "Straight-talking insights for improving the way your trade business works.",
	},
	{
		icon: Layers,
		title: "Practical support",
		desc: "Buttons, badges, cards, typography, motion, form controls, and layout primitives live in one reference page.",
	},
];

---

<Layout
	title="Smart Tradie Co | Helping tradies build smarter businesses"
	description="Helping tradies build smarter businesses."
	keywords="Smart Tradie Co, tradies, trade business, business growth"
>
	<HeroSection />

	<section class="site-container py-16 md:py-24">
		<SectionHeader
			title="Build a smarter trade business"
			description="Practical ideas and support for tradies who want better systems, clearer decisions, and room to grow."
		/>
		<div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
			{starterScope.map((item) => (
				<article
					class="rounded-xl border border-primary/10 bg-bg-secondary p-5 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_12px_30px_rgba(var(--color-primary-rgb),0.08)] dark:border-neutral-700 dark:bg-bg-secondary-dark"
				>
					<div class="mb-4 grid h-10 w-10 place-items-center rounded-lg bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-light">
						<item.icon class="h-5 w-5" />
					</div>
					<h3 class="mb-2 text-lg font-semibold text-neutral-800 dark:text-neutral-100">{item.title}</h3>
					<p class="text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">{item.desc}</p>
				</article>
			))}
		</div>
	</section>

	<section class="site-container py-12 md:py-20">
		<div
			class="rounded-xl border border-primary/10 bg-bg-secondary p-7 text-center dark:border-neutral-700 dark:bg-bg-secondary-dark md:p-10"
		>
			<div class="mb-4 flex justify-center">
				<div class="grid h-12 w-12 place-items-center rounded-xl bg-accent/30 text-neutral-800 dark:bg-accent/20 dark:text-neutral-100">
					<Sparkles class="h-5 w-5" />
				</div>
			</div>
			<h2 class="mx-auto mb-4 max-w-2xl text-3xl font-brand md:text-4xl">Ready to build smarter?</h2>
			<p class="mx-auto mb-7 max-w-2xl text-neutral-600 dark:text-neutral-300">
				Tell us where your business is today and what you want it to become.
			</p>
			<div class="flex flex-wrap justify-center gap-3">
				<Button url="/contact" type="fill">
					Apply now <ArrowRight size={16} />
				</Button>
			</div>
		</div>
	</section>
</Layout>
