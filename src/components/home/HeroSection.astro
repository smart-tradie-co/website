---
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import { BriefcaseBusiness } from "@lucide/astro";
---

<section class="relative z-20 site-container pt-16 md:pt-24 lg:pt-32">
	<div class="max-w-3xl">
		<div>
			<div class="mb-6 flex flex-wrap gap-2">
				<Badge variant="primary">Smart Tradie Co</Badge>
				<Badge variant="accent">Business systems for tradies</Badge>
			</div>

			<h1 class="mb-5 max-w-3xl text-4xl leading-tight md:text-5xl lg:text-6xl font-brand">
				Helping tradies build smarter businesses.
			</h1>

			<p class="mb-7 max-w-2xl text-base md:text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed">
				Practical support, better systems, and a clearer path forward for trade business owners who are ready to grow.
			</p>

			<div class="flex flex-wrap gap-3">
				<Button url="/contact" type="fill">
					<BriefcaseBusiness size={16} /> Apply now
				</Button>
			</div>
		</div>
	</div>
</section>
